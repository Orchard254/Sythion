# Sythion (Synth) - example environment configuration.
#
# Copy this file to `.env` for local development:
#
#     copy .env.example .env
#
# NEVER commit a real `.env`: it holds credentials. The release installer
# never ships a `.env` file - the packaging verification
# (scripts/verify_release_payload.py) fails the build if one appears in the
# staged payload.
#
# In a packaged installation the supported credential flow is the Windows
# Credential Manager: the first-run setup screen stores the key there and the
# backend reads it from the vault. The values below are only for local
# development.

# Ollama Cloud API key. Leave empty to read the key from the Windows
# Credential Manager.
SYTHION_OLLAMA_API_KEY=your-ollama-cloud-api-key-here

# Cloud model id selected during onboarding.
SYTHION_SELECTED_MODEL=replace-with-a-model-id

# Directories the file tools may access. Leave empty for the defaults.
SYTHION_FILE_ROOTS=
