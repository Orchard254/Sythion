{
  "manifest_version": 3,
  "name": "Sythion Browser Bridge",
  "version": "1.1.0",
  "description": "Real-time companion bridge connecting Google Chrome / Edge to your local Sythion AI assistant.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sythion Browser Bridge"
  }
}
